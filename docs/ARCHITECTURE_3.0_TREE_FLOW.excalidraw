    {"type": "rectangle", "id": "ext", "x": 1180, "y": 970, "width": 380, "height": 100, "backgroundColor": "#3a3a3a", "fillStyle": "solid", "roundness": {"type": 3}, "strokeColor": "#a0a0a0", "strokeWidth": 2, "boundElements": [{"id": "ext_text", "type": "text"}, {"id": "arr_torus_to_ext", "type": "arrow"}]},
    {"type": "text", "id": "ext_text", "x": 1185, "y": 975, "width": 370, "height": 90, "text": "[16] EXTERNAL INTEGRATION - 可插拔后端\n\nViennaRNA: RNA二级结构预测(~150ms本地)\nESM-2: 蛋白语言模型(2-5s GPU)\nNetMHCpan: MHC结合预测(AUC=0.92)\nOpenMM: 分子动力学精修(physics_ba模式)", "fontSize": 10, "fontFamily": 1, "strokeColor": "#e5e5e5", "textAlign": "left", "verticalAlign": "top", "containerId": "ext", "originalText": "[16] EXTERNAL INTEGRATION - 可插拔后端\n\nViennaRNA: RNA二级结构预测(~150ms本地)\nESM-2: 蛋白语言模型(2-5s GPU)\nNetMHCpan: MHC结合预测(AUC=0.92)\nOpenMM: 分子动力学精修(physics_ba模式)", "autoResize": true},
    {"type": "arrow", "id": "arr_torus_to_ext", "x": 1360, "y": 950, "width": 0, "height": 20, "points": [[0,0],[0,20]], "strokeColor": "#a0a0a0", "strokeWidth": 1, "endArrowhead": "arrow", "startBinding": {"elementId": "torus", "fixedPoint": [0.5, 1]}, "endBinding": {"elementId": "ext", "fixedPoint": [0.5, 0]}},

