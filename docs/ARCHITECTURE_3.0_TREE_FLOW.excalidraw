    {"type": "rectangle", "id": "mgr", "x": 730, "y": 320, "width": 220, "height": 100, "backgroundColor": "#8b5cf6", "fillStyle": "solid", "roundness": {"type": 3}, "strokeColor": "#8b5cf6", "strokeWidth": 3, "boundElements": [{"id": "mgr_text", "type": "text"}, {"id": "arr_orch_to_mgr", "type": "arrow"}, {"id": "arr_mgr_to_tumor", "type": "arrow"}, {"id": "arr_mgr_to_tme", "type": "arrow"}, {"id": "arr_mgr_to_rx", "type": "arrow"}, {"id": "arr_mgr_to_crna", "type": "arrow"}]},
    {"type": "text", "id": "mgr_text", "x": 735, "y": 325, "width": 210, "height": 90, "text": "[3] MANAGERS\nsubsystem_managers.py\n\n6个管理器统一调度\n通过EventBus异步通信", "fontSize": 12, "fontFamily": 1, "strokeColor": "#1a1b26", "textAlign": "center", "verticalAlign": "middle", "containerId": "mgr", "originalText": "[3] MANAGERS\nsubsystem_managers.py\n\n6个管理器统一调度\n通过EventBus异步通信", "autoResize": true},
