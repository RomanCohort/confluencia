    {"type": "rectangle", "id": "mgr", "x": 650, "y": 560, "width": 500, "height": 120, "backgroundColor": "#8b5cf6", "fillStyle": "solid", "roundness": {"type": 3}, "strokeColor": "#8b5cf6", "strokeWidth": 3, "boundElements": [{"id": "mgr_text", "type": "text"}]},
    {"type": "text", "id": "mgr_text", "x": 655, "y": 565, "width": 490, "height": 110, "text": "SUBSYSTEM MANAGERS (subsystem_managers.py)\n\nTumorManager | TMEManager | TreatmentManager\nBiomarkerManager | ClinicalManager | CircRNAManager*\n\n通过EventBus异步通信，统一调度各子系统", "fontSize": 12, "fontFamily": 1, "strokeColor": "#1a1b26", "textAlign": "center", "verticalAlign": "middle", "containerId": "mgr", "originalText": "SUBSYSTEM MANAGERS (subsystem_managers.py)\n\nTumorManager | TMEManager | TreatmentManager\nBiomarkerManager | ClinicalManager | CircRNAManager*\n\n通过EventBus异步通信，统一调度各子系统", "autoResize": true},

    {"type": "text", "id": "layer4_label", "x": 50, "y": 720, "text": "第4层: 子系统 (6个)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#e5e5e5", "originalText": "第4层: 子系统 (6个)", "autoResize": true},

    {"type": "rectangle", "id": "tumor", "x": 50, "y": 750, "width": 400, "height": 300, "backgroundColor": "#5c1a1a", "fillStyle": "solid", "roundness": {"type": 3}, "strokeColor": "#ef4444", "strokeWidth": 2, "opacity": 35, "boundElements": [{"id": "tumor_text", "type": "text"}, {"id": "arr_mgr_to_tumor", "type": "arrow"}, {"id": "arr_tumor_return", "type": "arrow"}]},
    {"type": "text", "id": "tumor_text", "x": 55, "y": 755, "width": 390, "height": 290, "text": "[4] TUMOR - TumorManager\n\nGrowthEngine (growth_engine.py)\n  tum_volume: 肿瘤体积(mm3)\n  tum_growth_rate: Logistic/Gompertz生长\n  tum_apoptosis_rate: 细胞凋亡率\n\nHeterogeneity (heterogeneity.py)\n  het_subclone_frac: 亚克隆比例\n  het_mutation_load: 突变负荷\n\nCSC Pool (cancer_stem_cell.py)\n  csc_pool_size: CD44+/CD24-干细胞\n  csc_self_renewal: 自我更新能力\n\nAngiogenesis (angiogenesis.py)\n  vasc_vegf_level: VEGF表达\n  vasc_mvd: 微血管密度\n\nMetastasis (metastasis.py)\n  met_sites: 转移部位\n  met_emt_marker: EMT标志物", "fontSize": 10, "fontFamily": 1, "strokeColor": "#e5e5e5", "textAlign": "left", "verticalAlign": "top", "containerId": "tumor", "originalText": "[4] TUMOR - TumorManager\n\nGrowthEngine (growth_engine.py)\n  tum_volume: 肿瘤体积(mm3)\n  tum_growth_rate: Logistic/Gompertz生长\n  tum_apoptosis_rate: 细胞凋亡率\n\nHeterogeneity (heterogeneity.py)\n  het_subclone_frac: 亚克隆比例\n  het_mutation_load: 突变负荷\n\nCSC Pool (cancer_stem_cell.py)\n  csc_pool_size: CD44+/CD24-干细胞\n  csc_self_renewal: 自我更新能力\n\nAngiogenesis (angiogenesis.py)\n  vasc_vegf_level: VEGF表达\n  vasc_mvd: 微血管密度\n\nMetastasis (metastasis.py)\n  met_sites: 转移部位\n  met_emt_marker: EMT标志物", "autoResize": true},
