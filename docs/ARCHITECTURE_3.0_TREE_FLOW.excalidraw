    {"type": "rectangle", "id": "tumor", "x": 20, "y": 460, "width": 350, "height": 250, "backgroundColor": "#5c1a1a", "fillStyle": "solid", "roundness": {"type": 3}, "strokeColor": "#ef4444", "strokeWidth": 2, "boundElements": [{"id": "tumor_text", "type": "text"}, {"id": "arr_mgr_to_tumor", "type": "arrow"}, {"id": "arr_tumor_to_mgr", "type": "arrow"}]},
    {"type": "text", "id": "tumor_text", "x": 25, "y": 465, "width": 340, "height": 240, "text": "[4] TUMOR SUBSYSTEM (tumor/) - TumorManager\n\nGrowthEngine(growth_engine.py)\n  tum_volume: 肿瘤体积(mm3)\n  tum_growth_rate: Logistic/Gompertz生长速率\n  tum_apoptosis_rate: 细胞凋亡率\n\nHeterogeneity(heterogeneity.py)\n  het_subclone_frac: 亚克隆比例\n  het_mutation_load: 突变负荷\n\nCSC Pool(cancer_stem_cell.py)\n  csc_pool_size: CD44+/CD24-干细胞池\n  csc_self_renewal: 自我更新能力\n\nAngiogenesis(angiogenesis.py)\n  vasc_vegf_level: VEGF表达水平\n  vasc_mvd: 微血管密度\n\nMetastasis(metastasis.py)\n  met_sites: 转移部位[Lung/Brain/Bone/Liver]\n  met_emt_marker: EMT标志物", "fontSize": 10, "fontFamily": 1, "strokeColor": "#e5e5e5", "textAlign": "left", "verticalAlign": "top", "containerId": "tumor", "originalText": "[4] TUMOR SUBSYSTEM (tumor/) - TumorManager\n\nGrowthEngine(growth_engine.py)\n  tum_volume: 肿瘤体积(mm3)\n  tum_growth_rate: Logistic/Gompertz生长速率\n  tum_apoptosis_rate: 细胞凋亡率\n\nHeterogeneity(heterogeneity.py)\n  het_subclone_frac: 亚克隆比例\n  het_mutation_load: 突变负荷\n\nCSC Pool(cancer_stem_cell.py)\n  csc_pool_size: CD44+/CD24-干细胞池\n  csc_self_renewal: 自我更新能力\n\nAngiogenesis(angiogenesis.py)\n  vasc_vegf_level: VEGF表达水平\n  vasc_mvd: 微血管密度\n\nMetastasis(metastasis.py)\n  met_sites: 转移部位[Lung/Brain/Bone/Liver]\n  met_emt_marker: EMT标志物", "autoResize": true},
